# JIAC FRIDAY — Environment Configuration Example
# ===============================================
# Copiar para .env e preencher com as chaves reais

# Gemini API (Google AI Studio)
# Obter em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (alternativa para alguns adapters)
# OPENAI_API_KEY=sk-...

# Anthropic (para Computer Use)
# ANTHROPIC_API_KEY=sk-ant-...

# Configurações do FRIDAY
FRIDAY_WORKSPACE=friday_workspace
FRIDAY_LOG_LEVEL=info

# Modelo Gemini preferido
GEMINI_MODEL=gemini-3.1-pro-preview
